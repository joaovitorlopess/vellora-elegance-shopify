{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="pagination__arrow" aria-label="{{ 'accessibility.previous' | t }}">{%- render 'icon', icon: 'chevron-left' -%}</a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}" class="pagination__page">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}
        <span class="pagination__page is-current" aria-current="page">{{ part.title }}</span>
      {%- else -%}
        <span class="pagination__page">{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="pagination__arrow" aria-label="{{ 'accessibility.next' | t }}">{%- render 'icon', icon: 'chevron-right' -%}</a>
    {%- endif -%}
  </nav>
{%- endif -%}

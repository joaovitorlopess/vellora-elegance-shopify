{%- liquid
  assign transparent = false
  if section.settings.transparent_home and template.name == 'index'
    assign transparent = true
  endif
  assign menu = section.settings.menu
-%}

<header
  class="site-header{% if transparent %} site-header--transparent{% endif %}{% if section.settings.sticky %} site-header--sticky{% endif %}"
  data-header
  data-transparent="{{ transparent }}"
>
  <div class="site-header__inner container container--wide">
    {%- comment -%} Esquerda: menu {%- endcomment -%}
    <div class="site-header__left">
      <button
        class="icon-btn site-header__burger"
        type="button"
        data-drawer-open="MenuDrawer"
        aria-controls="MenuDrawer"
        aria-expanded="false"
        aria-label="{{ 'header.open_menu' | t }}"
      >
        {%- render 'icon', icon: 'menu' -%}
      </button>

      <nav class="site-nav" aria-label="{{ 'header.main_nav' | t }}">
        <ul class="site-nav__list" role="list">
          {%- for link in menu.links -%}
            <li class="site-nav__item{% if link.links != blank %} has-mega{% endif %}" data-nav-item>
              <a
                href="{{ link.url }}"
                class="site-nav__link{% if link.active or link.child_active %} is-active{% endif %}"
                {% if link.links != blank %}aria-haspopup="true" aria-expanded="false"{% endif %}
              >
                {{- link.title | escape -}}
              </a>

              {%- if link.links != blank -%}
                <div class="mega" data-mega>
                  <div class="mega__inner container container--wide">
                    <div class="mega__columns">
                      {%- for child in link.links -%}
                        <div class="mega__col">
                          <a href="{{ child.url }}" class="mega__heading">{{ child.title | escape }}</a>
                          {%- if child.links != blank -%}
                            <ul class="mega__list" role="list">
                              {%- for grandchild in child.links -%}
                                <li><a href="{{ grandchild.url }}" class="mega__link">{{ grandchild.title | escape }}</a></li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                    </div>

                    {%- assign link_title = link.title | strip | downcase -%}
                    {%- for block in section.blocks -%}
                      {%- assign promo_title = block.settings.menu_item | strip | downcase -%}
                      {%- if promo_title == link_title -%}
                        <a href="{{ block.settings.link | default: link.url }}" class="mega__promo" {{ block.shopify_attributes }}>
                          <div class="mega__promo-media">
                            {%- if block.settings.image -%}
                              {{ block.settings.image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '320px', loading: 'lazy', class: 'mega__promo-img' }}
                            {%- elsif settings.demo_images -%}
                              {%- render 'demo-image', name: 'vellora-promo', class: 'mega__promo-img', width: 800, height: 1000, sizes: '300px' -%}
                            {%- else -%}
                              {{ 'lifestyle-1' | placeholder_svg_tag: 'mega__promo-img placeholder-svg' }}
                            {%- endif -%}
                          </div>
                          {%- if block.settings.heading != blank -%}
                            <p class="mega__promo-title">{{ block.settings.heading | escape }}</p>
                          {%- endif -%}
                          {%- if block.settings.label != blank -%}
                            <span class="link-underline">{{ block.settings.label | escape }}</span>
                          {%- endif -%}
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>

    {%- comment -%} Centro: logo {%- endcomment -%}
    {%- if template.name == 'index' -%}<h1 class="site-header__logo-wrap">{%- else -%}<div class="site-header__logo-wrap">{%- endif -%}
      <a href="{{ routes.root_url }}" class="site-header__logo" style="--logo-width: {{ section.settings.logo_width }}px;">
        {%- if section.settings.logo -%}
          {%- assign logo_alt = section.settings.logo.alt | default: shop.name -%}
          {{ section.settings.logo | image_url: width: 600 | image_tag: class: 'site-header__logo-img site-header__logo-img--default', alt: logo_alt, widths: '200, 300, 400, 600', sizes: '260px' }}
          {%- if section.settings.logo_inverse -%}
            {{ section.settings.logo_inverse | image_url: width: 600 | image_tag: class: 'site-header__logo-img site-header__logo-img--inverse', alt: logo_alt, widths: '200, 300, 400, 600', sizes: '260px' }}
          {%- endif -%}
        {%- else -%}
          <span class="site-header__wordmark">{{ shop.name | escape }}</span>
        {%- endif -%}
      </a>
    {%- if template.name == 'index' -%}</h1>{%- else -%}</div>{%- endif -%}

    {%- comment -%} Direita: ícones {%- endcomment -%}
    <div class="site-header__icons">
      {%- if section.settings.show_search -%}
        <button class="icon-btn" type="button" data-search-open aria-label="{{ 'header.search' | t }}">
          {%- render 'icon', icon: 'search' -%}
        </button>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="icon-btn icon-btn--hide-mobile" aria-label="{{ 'header.account' | t }}">
          {%- render 'icon', icon: 'account' -%}
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="icon-btn site-header__cart" aria-label="{{ 'header.cart' | t }}">
        {%- render 'icon', icon: 'bag' -%}
        <span class="cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{%- comment -%} Menu mobile {%- endcomment -%}
<div class="drawer" id="MenuDrawer" data-drawer aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'header.menu' | t }}" tabindex="-1">
    <div class="drawer__header">
      <span class="eyebrow">{{ 'header.menu' | t }}</span>
      <button class="icon-btn" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
        {%- render 'icon', icon: 'close' -%}
      </button>
    </div>

    <nav class="drawer__nav" aria-label="{{ 'header.main_nav' | t }}">
      <ul class="drawer__list" role="list">
        {%- for link in menu.links -%}
          <li class="drawer__item">
            {%- if link.links != blank -%}
              <details class="drawer__details">
                <summary class="drawer__link">
                  {{- link.title | escape -}}
                  {%- render 'icon', icon: 'plus' -%}
                </summary>
                <ul class="drawer__sublist" role="list">
                  <li><a href="{{ link.url }}" class="drawer__sublink drawer__sublink--all">{{ 'general.view_all' | t }}</a></li>
                  {%- for child in link.links -%}
                    <li>
                      <a href="{{ child.url }}" class="drawer__sublink">{{ child.title | escape }}</a>
                      {%- if child.links != blank -%}
                        <ul class="drawer__subsublist" role="list">
                          {%- for grandchild in child.links -%}
                            <li><a href="{{ grandchild.url }}" class="drawer__subsublink">{{ grandchild.title | escape }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}" class="drawer__link">{{ link.title | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="drawer__footer">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="drawer__utility">
          {%- render 'icon', icon: 'account' -%}
          <span>{% if customer %}{{ 'header.my_account' | t }}{% else %}{{ 'header.login' | t }}{% endif %}</span>
        </a>
      {%- endif -%}
      {%- render 'social-links' -%}
    </div>
  </div>
</div>

{%- comment -%} Busca em tela cheia {%- endcomment -%}
{%- if section.settings.show_search -%}
  <div class="search-overlay" data-search aria-hidden="true">
    <div class="search-overlay__inner container">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-overlay__form">
        <label for="HeaderSearch" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
        <input
          id="HeaderSearch"
          type="search"
          name="q"
          class="search-overlay__input"
          placeholder="{{ 'search.placeholder' | t }}"
          autocomplete="off"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="icon-btn" aria-label="{{ 'search.submit' | t }}">{%- render 'icon', icon: 'search' -%}</button>
        <button type="button" class="icon-btn" data-search-close aria-label="{{ 'accessibility.close' | t }}">{%- render 'icon', icon: 'close' -%}</button>
      </form>
      {%- if section.settings.search_suggestions != blank -%}
        <div class="search-overlay__suggestions">
          <p class="eyebrow">{{ 'search.popular' | t }}</p>
          <ul role="list">
            {%- assign suggestions = section.settings.search_suggestions | split: ',' -%}
            {%- for term in suggestions -%}
              {%- assign clean_term = term | strip -%}
              <li><a href="{{ routes.search_url }}?q={{ clean_term | url_encode }}&options%5Bprefix%5D=last">{{ clean_term | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Cabeçalho",
  "class": "section-header",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    {
      "type": "image_picker",
      "id": "logo_inverse",
      "label": "Logo claro (sobre o banner)",
      "info": "Usado quando o cabeçalho está transparente sobre imagens escuras."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Largura do logo",
      "min": 80,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 170
    },
    { "type": "header", "content": "Navegação" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_search", "label": "Mostrar busca", "default": true },
    { "type": "text", "id": "search_suggestions", "label": "Buscas populares", "info": "Separadas por vírgula.", "default": "Vestidos, Alfaiataria, Seda, Tricô" },
    { "type": "checkbox", "id": "show_account", "label": "Mostrar ícone de conta", "default": true },
    { "type": "header", "content": "Comportamento" },
    { "type": "checkbox", "id": "sticky", "label": "Fixar no topo ao rolar", "default": true },
    {
      "type": "checkbox",
      "id": "transparent_home",
      "label": "Transparente sobre o banner da página inicial",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Destaque do mega menu",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Item do menu",
          "info": "Digite exatamente o nome do item principal do menu (ex.: Coleções)."
        },
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Nova coleção" },
        { "type": "text", "id": "label", "label": "Texto do link", "default": "Descobrir" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}

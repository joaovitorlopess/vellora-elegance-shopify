{%- liquid
  assign slide_count = section.blocks.size
  assign overlay = section.settings.overlay | divided_by: 100.0
-%}

<section
  class="hero hero--{{ section.settings.height }}{% if section.settings.full_bleed_header %} hero--under-header{% endif %}"
  style="--hero-overlay: {{ overlay }};"
  data-slideshow
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.speed | times: 1000 }}"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.aria_label | escape }}"
>
  <div class="hero__track">
    {%- for block in section.blocks -%}
      {%- liquid
        assign loading = 'lazy'
        if forloop.first and section.index == 1
          assign loading = 'eager'
        endif
        assign heading_tag = 'h2'
      -%}
      <div
        class="hero__slide hero__slide--{{ block.settings.text_color }}{% if forloop.first %} is-active{% endif %}"
        data-slide
        role="group"
        aria-roledescription="slide"
        aria-label="{{ 'accessibility.slide_of' | t: index: forloop.index, total: slide_count }}"
        {% unless forloop.first %}aria-hidden="true"{% endunless %}
        {{ block.shopify_attributes }}
      >
        <div class="hero__media">
          {%- if block.settings.image -%}
            <picture>
              {%- if block.settings.image_mobile -%}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w, {{ block.settings.image_mobile | image_url: width: 1500 }} 1500w"
                  sizes="100vw"
                >
              {%- endif -%}
              {{
                block.settings.image
                | image_url: width: 3200
                | image_tag:
                  widths: '750, 1100, 1500, 1920, 2400, 3200',
                  sizes: '100vw',
                  loading: loading,
                  class: 'hero__img',
                  style: block.settings.focal_style
              }}
            </picture>
          {%- elsif settings.demo_images -%}
            {%- capture demo_n -%}{% cycle '1', '2' %}{%- endcapture -%}
            {%- assign demo_desktop = 'vellora-hero-' | append: demo_n -%}
            <picture>
              <source media="(max-width: 749px)" srcset="{%- render 'demo-src', name: demo_desktop, w: 1080, h: 1620, mobile: true -%}">
              {%- render 'demo-image', name: demo_desktop, class: 'hero__img', loading: loading, width: 2400, height: 1350, sizes: '100vw' -%}
            </picture>
          {%- else -%}
            {%- capture placeholder_name -%}lifestyle-{% cycle '1', '2' %}{%- endcapture -%}
            {{ placeholder_name | placeholder_svg_tag: 'hero__img placeholder-svg placeholder-svg--dark' }}
          {%- endif -%}
        </div>

        <div class="hero__content container container--wide hero__content--{{ block.settings.position }}">
          <div class="hero__text" data-reveal>
            {%- if block.settings.eyebrow != blank -%}
              <p class="eyebrow hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <{{ heading_tag }} class="display hero__heading">{{ block.settings.heading }}</{{ heading_tag }}>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="hero__subtext">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank or block.settings.button_label_2 != blank -%}
              <div class="hero__buttons">
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="btn {% if block.settings.text_color == 'light' %}btn--light{% else %}btn--dark{% endif %}">
                    {{- block.settings.button_label | escape -}}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  <a href="{{ block.settings.button_link_2 | default: routes.collections_url }}" class="link-underline hero__link">
                    {{- block.settings.button_label_2 | escape -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if slide_count > 1 -%}
    <div class="hero__controls container container--wide">
      <div class="hero__dots">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="hero__dot{% if forloop.first %} is-active{% endif %}"
            data-slide-to="{{ forloop.index0 }}"
            aria-label="{{ 'accessibility.go_to_slide' | t: index: forloop.index }}"
            {% if forloop.first %}aria-current="true"{% endif %}
          >
            <span class="hero__dot-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="hero__dot-bar"><span class="hero__dot-progress"></span></span>
          </button>
        {%- endfor -%}
      </div>
      <div class="hero__arrows">
        <button type="button" class="icon-btn" data-slide-prev aria-label="{{ 'accessibility.previous' | t }}">{%- render 'icon', icon: 'chevron-left' -%}</button>
        <button type="button" class="icon-btn" data-slide-next aria-label="{{ 'accessibility.next' | t }}">{%- render 'icon', icon: 'chevron-right' -%}</button>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Banner principal",
  "tag": "div",
  "class": "section-hero",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Altura",
      "options": [
        { "value": "full", "label": "Tela cheia" },
        { "value": "large", "label": "Grande" },
        { "value": "medium", "label": "Média" }
      ],
      "default": "full"
    },
    {
      "type": "checkbox",
      "id": "full_bleed_header",
      "label": "Passar por baixo do cabeçalho transparente",
      "info": "Use com \"Transparente sobre o banner\" ativado no cabeçalho.",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Escurecimento da imagem",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    { "type": "checkbox", "id": "autoplay", "label": "Troca automática", "default": true },
    {
      "type": "range",
      "id": "speed",
      "label": "Tempo por slide",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    { "type": "text", "id": "aria_label", "label": "Nome acessível do carrossel", "default": "Destaques da coleção" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem (desktop)", "info": "Recomendado: 2880 x 1600 px." },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagem (celular)", "info": "Recomendado: 1080 x 1620 px (retrato)." },
        {
          "type": "select",
          "id": "focal_style",
          "label": "Foco da imagem",
          "options": [
            { "value": "object-position: center center;", "label": "Centro" },
            { "value": "object-position: center top;", "label": "Topo" },
            { "value": "object-position: center bottom;", "label": "Base" },
            { "value": "object-position: left center;", "label": "Esquerda" },
            { "value": "object-position: right center;", "label": "Direita" }
          ],
          "default": "object-position: center center;"
        },
        { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Coleção Outono Inverno" },
        { "type": "inline_richtext", "id": "heading", "label": "Título", "info": "Use itálico para destacar uma palavra.", "default": "A elegância está no <em>silêncio</em>" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Alfaiataria fluida, tons neutros e tecidos que tocam a pele com suavidade." },
        { "type": "text", "id": "button_label", "label": "Botão principal", "default": "Descobrir coleção" },
        { "type": "url", "id": "button_link", "label": "Link do botão principal" },
        { "type": "text", "id": "button_label_2", "label": "Link secundário", "default": "Ver lookbook" },
        { "type": "url", "id": "button_link_2", "label": "URL do link secundário" },
        {
          "type": "select",
          "id": "position",
          "label": "Posição do texto",
          "options": [
            { "value": "bottom-left", "label": "Inferior esquerda" },
            { "value": "bottom-center", "label": "Inferior centro" },
            { "value": "center-left", "label": "Centro esquerda" },
            { "value": "center", "label": "Centro" },
            { "value": "center-right", "label": "Centro direita" }
          ],
          "default": "bottom-left"
        },
        {
          "type": "select",
          "id": "text_color",
          "label": "Cor do texto",
          "options": [
            { "value": "light", "label": "Claro" },
            { "value": "dark", "label": "Escuro" }
          ],
          "default": "light"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner principal",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}

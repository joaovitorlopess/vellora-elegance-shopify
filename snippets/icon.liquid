{%- comment -%}
  Ícones de traço fino (1.25px), consistentes com a estética minimalista.
  Uso: {% render 'icon', icon: 'bag' %}
{%- endcomment -%}
{%- case icon -%}
  {%- when 'menu' -%}
    <svg class="icon icon--menu" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M3 7h18M3 12h18M3 17h12"/></svg>
  {%- when 'close' -%}
    <svg class="icon icon--close" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M5 5l14 14M19 5L5 19"/></svg>
  {%- when 'search' -%}
    <svg class="icon icon--search" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></svg>
  {%- when 'account' -%}
    <svg class="icon icon--account" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.2-4 4.3-6 8-6s6.8 2 8 6"/></svg>
  {%- when 'bag' -%}
    <svg class="icon icon--bag" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M5 8h14l-1 13H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
  {%- when 'arrow-right' -%}
    <svg class="icon icon--arrow" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M3 12h17M14 6l6 6-6 6"/></svg>
  {%- when 'chevron-down' -%}
    <svg class="icon icon--chevron" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M6 9l6 6 6-6"/></svg>
  {%- when 'chevron-left' -%}
    <svg class="icon icon--chevron" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M15 6l-6 6 6 6"/></svg>
  {%- when 'chevron-right' -%}
    <svg class="icon icon--chevron" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M9 6l6 6-6 6"/></svg>
  {%- when 'plus' -%}
    <svg class="icon icon--plus" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}
    <svg class="icon icon--minus" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M5 12h14"/></svg>
  {%- when 'truck' -%}
    <svg class="icon icon--truck" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M2 6h12v10H2zM14 10h4l3 3v3h-7"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
  {%- when 'exchange' -%}
    <svg class="icon icon--exchange" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M4 8h14l-3-3M20 16H6l3 3"/></svg>
  {%- when 'card' -%}
    <svg class="icon icon--card" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><rect x="2.5" y="5" width="19" height="14" rx="1.5"/><path d="M2.5 10h19M6 15h4"/></svg>
  {%- when 'pix' -%}
    <svg class="icon icon--pix" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M12 2.5l9.5 9.5-9.5 9.5L2.5 12z"/><path d="M7 12l5-5 5 5-5 5z"/></svg>
  {%- when 'shield' -%}
    <svg class="icon icon--shield" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6l8-3z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
  {%- when 'gift' -%}
    <svg class="icon icon--gift" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M3.5 9h17v4h-17zM5 13h14v8H5zM12 9v12"/><path d="M12 9C10 5 6.5 5.5 7 7.5S12 9 12 9zm0 0c2-4 5.5-3.5 5-1.5S12 9 12 9z"/></svg>
  {%- when 'star' -%}
    <svg class="icon icon--star" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.8l-5.2 2.8 1-5.8-4.3-4.1 5.9-.8z"/></svg>
  {%- when 'instagram' -%}
    <svg class="icon icon--instagram" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor"/></svg>
  {%- when 'tiktok' -%}
    <svg class="icon icon--tiktok" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.8 2.2 4.5 5 4.8"/></svg>
  {%- when 'facebook' -%}
    <svg class="icon icon--facebook" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M14.5 8H17V4.5h-2.5A3.5 3.5 0 0 0 11 8v2.5H8.5V14H11v6.5h3.5V14H17l.5-3.5h-3V8.5c0-.3.2-.5.5-.5z"/></svg>
  {%- when 'pinterest' -%}
    <svg class="icon icon--pinterest" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><circle cx="12" cy="12" r="9"/><path d="M11 9.5c-1.5 5-2 8-3 11M10.5 13.5c3 1.5 6-.5 6-3.5 0-2.5-2-4.5-4.7-4.5C8.8 5.5 7 7.4 7 9.7c0 1 .4 1.9 1 2.3"/></svg>
  {%- when 'youtube' -%}
    <svg class="icon icon--youtube" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><rect x="2.5" y="5.5" width="19" height="13" rx="3.5"/><path d="M10 9.5v5l4.5-2.5z"/></svg>
  {%- when 'whatsapp' -%}
    <svg class="icon icon--whatsapp" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4.5 19.5l1.2-3.8A8.5 8.5 0 1 1 8.6 18.5z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8c-1-.5-2-1.5-2.5-2.5l.8-1-1-2z"/></svg>
  {%- when 'pause' -%}
    <svg class="icon icon--pause" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 6v12M15 6v12"/></svg>
  {%- when 'play' -%}
    <svg class="icon icon--play" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M8 5.5v13l10-6.5z"/></svg>
{%- endcase -%}

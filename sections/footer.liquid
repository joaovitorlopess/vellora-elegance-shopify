<footer class="site-footer" style="--footer-bg: {{ section.settings.color_bg }}; --footer-text: {{ section.settings.color_text }};">
  <div class="container container--wide">
    {%- liquid
      assign footer_newsletter = section.settings.show_newsletter
      if template.name == 'index' and section.settings.hide_newsletter_home
        assign footer_newsletter = false
      endif
    -%}
    {%- if footer_newsletter -%}
      <div class="site-footer__newsletter">
        <div class="site-footer__newsletter-text">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="h3">{{ section.settings.newsletter_heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.newsletter_text != blank -%}
            <div class="rte">{{ section.settings.newsletter_text }}</div>
          {%- endif -%}
        </div>
        {%- render 'newsletter-form', form_id: 'FooterNewsletter' -%}
      </div>
    {%- endif -%}

    <div class="site-footer__grid">
      {%- for block in section.blocks -%}
        <div class="site-footer__block site-footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'brand' -%}
              {%- if block.settings.logo -%}
                {{ block.settings.logo | image_url: width: 400 | image_tag: class: 'site-footer__logo', loading: 'lazy', style: 'max-width: 180px; height: auto;' }}
              {%- else -%}
                <p class="site-footer__wordmark">{{ shop.name | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="rte site-footer__about">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.show_social -%}
                {%- render 'social-links' -%}
              {%- endif -%}

            {%- when 'menu' -%}
              <details class="site-footer__details" open>
                <summary class="site-footer__heading">
                  {{- block.settings.heading | default: block.settings.menu.title | escape -}}
                  {%- render 'icon', icon: 'plus' -%}
                </summary>
                <ul class="site-footer__links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>

            {%- when 'text' -%}
              <details class="site-footer__details" open>
                <summary class="site-footer__heading">
                  {{- block.settings.heading | escape -}}
                  {%- render 'icon', icon: 'plus' -%}
                </summary>
                <div class="rte site-footer__text">{{ block.settings.text }}</div>
              </details>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copy">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}.
        {%- if section.settings.legal_text != blank %} {{ section.settings.legal_text | escape }}{% endif %}
      </p>
      {%- if section.settings.show_payment_icons -%}
        <ul class="payment-icons" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icons__icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé",
  "class": "section-footer",
  "max_blocks": 6,
  "settings": [
    { "type": "color", "id": "color_bg", "label": "Cor de fundo", "default": "#141414" },
    { "type": "color", "id": "color_text", "label": "Cor do texto", "default": "#EFE8DC" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Mostrar newsletter", "default": true },
    { "type": "checkbox", "id": "hide_newsletter_home", "label": "Ocultar na página inicial", "info": "Evita duplicar quando a página inicial já tem a seção Newsletter.", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Título", "default": "Entre para o Círculo Vellora" },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "Texto",
      "default": "<p>Acesso antecipado às coleções, convites exclusivos e novidades.</p>"
    },
    { "type": "header", "content": "Rodapé inferior" },
    { "type": "text", "id": "legal_text", "label": "Texto legal", "default": "Todos os direitos reservados." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Mostrar formas de pagamento", "default": true }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marca",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo (versão clara)" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Peças atemporais, tecidos nobres e acabamento impecável. Moda feminina pensada para durar.</p>"
        },
        { "type": "checkbox", "id": "show_social", "label": "Mostrar redes sociais", "default": true }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Atendimento" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Segunda a sexta, das 9h às 18h<br>contato@velloraelegance.com.br</p>"
        }
      ]
    }
  ]
}
{% endschema %}

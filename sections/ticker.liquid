{%- if section.blocks.size > 0 -%}
  <div
    class="ticker ticker--{{ section.settings.style }}"
    style="--ticker-duration: {{ section.settings.duration }}s;"
    aria-label="{{ section.settings.aria_label | escape }}"
    role="region"
  >
    <div class="ticker__track">
      {%- for i in (1..2) -%}
        <ul class="ticker__group" role="list" {% if i == 2 %}aria-hidden="true"{% endif %}>
          {%- for n in (1..3) -%}
            {%- for block in section.blocks -%}
              <li class="ticker__item" {% if i == 1 and n == 1 %}{{ block.shopify_attributes }}{% endif %}>
                <span>{{ block.settings.text | escape }}</span>
                <span class="ticker__sep" aria-hidden="true">✦</span>
              </li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Faixa em movimento",
  "tag": "div",
  "class": "section-ticker",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        { "value": "light", "label": "Champagne" },
        { "value": "dark", "label": "Preto" },
        { "value": "outline", "label": "Linhas finas" }
      ],
      "default": "outline"
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Duração do ciclo (maior = mais lento)",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "s",
      "default": 45
    },
    { "type": "text", "id": "aria_label", "label": "Nome acessível", "default": "Destaques da marca" }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Tecidos nobres" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Faixa em movimento",
      "blocks": [
        { "type": "text", "settings": { "text": "Tecidos nobres" } },
        { "type": "text", "settings": { "text": "Design atemporal" } },
        { "type": "text", "settings": { "text": "Produção responsável" } }
      ]
    }
  ]
}
{% endschema %}

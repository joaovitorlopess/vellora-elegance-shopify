{%- comment -%}
  Tokens de design da VELLORA ELEGANCE.
  Todas as cores, fontes e medidas vêm de config/settings_schema.json
  e podem ser alteradas no personalizador em "Configurações do tema".
{%- endcomment -%}
{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_body_font
  assign body_font_medium = body_font | font_modify: 'weight', '500'
  assign body_font_bold = body_font | font_modify: 'weight', '600'
  assign heading_font_italic = heading_font | font_modify: 'style', 'italic'
-%}

{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {%- if body_font_medium -%}{{ body_font_medium | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if body_font_bold -%}{{ body_font_bold | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if heading_font_italic -%}{{ heading_font_italic | font_face: font_display: 'swap' }}{%- endif -%}

  :root {
    /* Tipografia */
    --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-heading-weight: {{ heading_font.weight }};
    --font-heading-style: {{ heading_font.style }};
    --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-body-weight: {{ body_font.weight }};
    --font-body-weight-medium: {% if body_font_medium %}{{ body_font_medium.weight }}{% else %}{{ body_font.weight }}{% endif %};
    --font-body-weight-bold: {% if body_font_bold %}{{ body_font_bold.weight }}{% else %}{{ body_font.weight }}{% endif %};
    --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --body-scale: {{ settings.body_scale | divided_by: 100.0 }};
    --heading-letter-spacing: {{ settings.heading_letter_spacing | divided_by: 100.0 }}em;

    /* Paleta Quiet Luxury */
    --color-bg: {{ settings.color_background }};
    --color-bg-alt: {{ settings.color_background_alt }};
    --color-champagne: {{ settings.color_champagne }};
    --color-text: {{ settings.color_text }};
    --color-text-muted: {{ settings.color_text | color_modify: 'alpha', 0.62 }};
    --color-accent: {{ settings.color_accent }};
    --color-border: {{ settings.color_text | color_modify: 'alpha', 0.12 }};
    --color-border-strong: {{ settings.color_text | color_modify: 'alpha', 0.3 }};
    --color-button: {{ settings.color_button }};
    --color-button-text: {{ settings.color_button_text }};
    --color-sale: {{ settings.color_sale }};
    --color-overlay: {{ settings.color_text }};

    /* Layout */
    --page-width: {{ settings.page_width }}px;
    --page-gutter: clamp(1.25rem, 4vw, 3.5rem);
    --section-spacing: {{ settings.section_spacing }}px;
    --radius: {{ settings.border_radius }}px;
    --card-ratio: {{ settings.card_image_ratio }};
  }
{% endstyle %}

<section class="page-width collection-page"><div class="collection-intro"><p class="eyebrow">EXPLORE A VELLORA</p><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div>{{ collection.description }}</div>{% endif %}</div>
{% paginate collection.products by 16 %}<div class="product-grid">{% for product in collection.products %}{% render 'vellora-product-card', product: product %}{% else %}<p>Nenhum produto encontrado nesta coleção.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="Paginação">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Anterior</a>{% endif %}<span>Página {{ paginate.current_page }} de {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">Próxima →</a>{% endif %}</nav>{% endif %}{% endpaginate %}</section>
{% schema %}{"name":"Coleção principal","settings":[]} {% endschema %}
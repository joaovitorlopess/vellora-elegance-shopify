{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} &ndash; {{ shop.name }}</title>
    {%- render 'css-variables' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body>
    <main class="section container container--narrow empty-state empty-state--page gift-card">
      <p class="eyebrow">{{ shop.name | escape }}</p>
      <h1 class="h1">{{ 'gift_card.title' | t }}</h1>
      <p class="h2">{{ gift_card.balance | money }}</p>
      {%- if gift_card.expired or gift_card.enabled == false -%}
        <p>{{ 'gift_card.expired' | t }}</p>
      {%- endif -%}
      <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <a href="{{ shop.url }}" class="btn btn--dark">{{ 'cart.continue' | t }}</a>
      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}" class="link-underline">Apple Wallet</a>
      {%- endif -%}
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>

<section class="page-width cart-page"><p class="eyebrow">SUA SELEÇÃO</p><h1>Sacola de compras</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post" id="CartForm"><div class="cart-items">{% for item in cart.items %}<div class="cart-row">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}{% endif %}<div class="cart-item-info"><a href="{{ item.url }}">{{ item.product.title | escape }}</a>{% unless item.variant.title == 'Default Title' %}<p>{{ item.variant.title | escape }}</p>{% endunless %}<p>{{ item.final_price | money }}</p><label for="CartQty-{{ item.index | plus: 1 }}">Quantidade</label><input id="CartQty-{{ item.index | plus: 1 }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div><strong>{{ item.final_line_price | money }}</strong><a href="{{ item.url_to_remove }}" class="remove-link">Remover</a></div>{% endfor %}</div><button class="button button-outline" type="submit" name="update">Atualizar sacola</button><div class="cart-summary"><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><p class="muted">Frete e descontos calculados na finalização da compra.</p><button class="button button-dark" type="submit" name="checkout">Finalizar compra ↗</button><a class="continue-link" href="/collections/all">Continuar comprando</a></div></form>{% else %}<div class="empty-collection"><p>Sua sacola está vazia por enquanto.</p><a class="button button-dark" href="/collections/all">Explorar coleção</a></div>{% endif %}</section>
{% schema %}{"name":"Sacola de compras","settings":[]} {% endschema %}
<section class="benefits page-width">
  {% for block in section.blocks %}
    <div class="benefit" {{ block.shopify_attributes }}><span class="benefit-symbol">{{ block.settings.symbol | escape }}</span><div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></div></div>
  {% endfor %}
</section>

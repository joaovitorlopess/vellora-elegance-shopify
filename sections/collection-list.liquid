{%- liquid
  assign count = section.blocks.size
  assign columns = section.settings.columns
  if count < columns
    assign columns = count
  endif
-%}

<section class="section section--{{ section.settings.background }}">
  <div class="container container--wide">
    {%- render 'section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      align: 'center'
    -%}

    <ul
      class="collection-grid collection-grid--{{ section.settings.layout }}{% if section.settings.mobile_slider %} collection-grid--slider-mobile{% endif %}"
      style="--columns: {{ columns }};"
      role="list"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign title = block.settings.title | default: c.title
          assign url = c.url | default: routes.collections_url
          assign image = block.settings.image | default: c.featured_image
        -%}
        <li class="collection-grid__item" data-reveal style="--reveal-delay: {{ forloop.index0 | times: 90 }}ms;" {{ block.shopify_attributes }}>
          <a href="{{ url }}" class="collection-card">
            <div class="collection-card__media">
              {%- if image -%}
                {{
                  image
                  | image_url: width: 1400
                  | image_tag:
                    widths: '450, 700, 1000, 1400',
                    sizes: '(min-width: 990px) 33vw, 80vw',
                    loading: 'lazy',
                    class: 'collection-card__img',
                    alt: title
                }}
              {%- elsif settings.demo_images -%}
                {%- assign demo_n = forloop.index0 | modulo: 3 | plus: 1 -%}
                {%- assign demo_name = 'vellora-category-' | append: demo_n -%}
                {%- render 'demo-image', name: demo_name, class: 'collection-card__img', alt: title, width: 1050, height: 1400, sizes: '(min-width: 990px) 33vw, 80vw' -%}
              {%- else -%}
                {%- capture placeholder -%}collection-{{ forloop.index | modulo: 6 | plus: 1 }}{%- endcapture -%}
                {{ placeholder | placeholder_svg_tag: 'collection-card__img placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="collection-card__info">
              <h3 class="h3 collection-card__title">{{ title | default: 'Coleção' | escape }}</h3>
              <span class="link-underline collection-card__cta">{{ section.settings.cta_label | escape }}</span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Lista de coleções",
  "tag": "div",
  "class": "section-collection-list",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Explore" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Compre por categoria" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grade uniforme" },
        { "value": "editorial", "label": "Editorial (primeiro item maior)" }
      ],
      "default": "editorial"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Colunas no desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    { "type": "checkbox", "id": "mobile_slider", "label": "Carrossel deslizante no celular", "default": true },
    { "type": "text", "id": "cta_label", "label": "Texto do link", "default": "Explorar" },
    {
      "type": "select",
      "id": "background",
      "label": "Fundo",
      "options": [
        { "value": "default", "label": "Off-white" },
        { "value": "alt", "label": "Bege claro" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Coleção",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "image_picker", "id": "image", "label": "Imagem personalizada", "info": "Recomendado: retrato 3:4." },
        { "type": "text", "id": "title", "label": "Título personalizado" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lista de coleções",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}

<section class="collection-section page-width">
  <div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><a class="text-link" href="{{ section.settings.collection.url | default: '/collections/all' }}">Ver toda a coleção ↗</a></div>
  {% assign chosen_collection = section.settings.collection %}
  {% if chosen_collection != blank and chosen_collection.products_count > 0 %}
    <div class="product-grid">
      {% for product in chosen_collection.products limit: section.settings.products_to_show %}
        {% render 'vellora-product-card', product: product %}
      {% endfor %}
    </div>
  {% else %}
    <div class="empty-collection"><p>Escolha uma coleção no editor do tema para exibir seus produtos aqui.</p><a class="button button-dark" href="/collections/all">Ver produtos</a></div>
  {% endif %}
</section>
{% schema %}
{"name":"Coleção em destaque","settings":[{"type":"text","id":"eyebrow","label":"Texto superior","default":"ESCOLHAS DA VELLORA"},{"type":"text","id":"heading","label":"Título","default":"Favoritos da temporada"},{"type":"collection","id":"collection","label":"Coleção"},{"type":"range","id":"products_to_show","label":"Quantidade de produtos","min":2,"max":8,"step":1,"default":4}]}
{% endschema %}
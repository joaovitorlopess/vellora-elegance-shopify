{%- if section.blocks.size > 0 -%}
  <div
    class="announcement"
    style="--announcement-bg: {{ section.settings.color_bg }}; --announcement-text: {{ section.settings.color_text }};"
    data-announcement
    data-interval="{{ section.settings.interval | times: 1000 }}"
    role="region"
    aria-label="{{ 'header.announcement' | t }}"
  >
    <div class="announcement__track container container--wide">
      {%- for block in section.blocks -%}
        <div class="announcement__item{% if forloop.first %} is-active{% endif %}" data-announcement-item {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="announcement__link">{{ block.settings.text | escape }}</a>
          {%- else -%}
            <span>{{ block.settings.text | escape }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anúncios",
  "class": "section-announcement",
  "max_blocks": 6,
  "settings": [
    { "type": "color", "id": "color_bg", "label": "Cor de fundo", "default": "#141414" },
    { "type": "color", "id": "color_text", "label": "Cor do texto", "default": "#E3D5BE" },
    {
      "type": "range",
      "id": "interval",
      "label": "Troca de mensagem a cada",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Mensagem",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Frete grátis para todo o Brasil acima de R$ 499" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de anúncios",
      "blocks": [
        { "type": "announcement" }
      ]
    }
  ]
}
{% endschema %}

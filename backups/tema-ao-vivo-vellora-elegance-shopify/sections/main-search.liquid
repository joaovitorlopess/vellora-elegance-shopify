<section class="page-width collection-page"><h1>Buscar na Vellora</h1><form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><label class="visually-hidden" for="SearchQuery">Buscar produtos</label><input id="SearchQuery" type="search" name="q" value="{{ search.terms | escape }}" placeholder="O que você está procurando?"><input type="hidden" name="type" value="product"><button class="button button-dark" type="submit">Buscar</button></form>{% if search.performed %}<p>Resultados para “{{ search.terms | escape }}”</p><div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'vellora-product-card', product: item %}{% endif %}{% else %}<p>Nenhum resultado encontrado.</p>{% endfor %}</div>{% endif %}</section>{% schema %}{"name":"Busca"}{% endschema %}